<Window x:Class="MeyDrive.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mey Drive" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="{StaticResource Bg}" Icon="app.ico"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="50" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Border BorderBrush="#1C1C22" BorderThickness="1">
    <StackPanel>

      <!-- title bar -->
      <Grid Height="50" Margin="18,0,12,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="app.ico" Width="22" Height="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
          <!-- one TextBlock so both parts share a baseline -->
          <TextBlock VerticalAlignment="Center">
            <Run Text="MEY DRIVE" FontSize="14" FontWeight="Black"/>
            <Run Text=" ·  Assetto Corsa" FontSize="13" Foreground="{StaticResource Dim}"/>
          </TextBlock>
          <!-- Content Manager mark, outline only -->
          <Viewbox Width="20" Height="20" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="Content Manager">
            <Canvas Width="256" Height="256">
              <Path Stroke="#FF0000" StrokeThickness="9" StrokeLineJoin="Round"
                    Data="M4,90 L89,7 L89,57 L4,140 Z M5,155 L50,110 L52,138 L136,55 L136,108 L55,188 L5,188 Z"/>
              <Path Stroke="#8E8E98" StrokeThickness="9" StrokeLineJoin="Round"
                    Data="M61,193 L193,64 L193,162 L147,207 L145,162 L62,245 Z M201,110 L249,64 L249,162 L203,207 Z"/>
            </Canvas>
          </Viewbox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <!-- language: the selected one gets the red frame -->
          <Button x:Name="LangTr" Style="{StaticResource LangButton}" Content="TR" Click="OnLanguageTr"
                  WindowChrome.IsHitTestVisibleInChrome="True"/>
          <Button x:Name="LangEn" Style="{StaticResource LangButton}" Content="EN" Click="OnLanguageEn" Margin="4,0,10,0"
                  WindowChrome.IsHitTestVisibleInChrome="True"/>
          <Button Style="{StaticResource TitleButton}" ToolTip="{DynamicResource L.Minimize}"
                  Click="OnMinimize" WindowChrome.IsHitTestVisibleInChrome="True">
            <Path Data="M0,0.5 L10,0.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.2" Width="10" Height="1" SnapsToDevicePixels="True"/>
          </Button>
          <Button Style="{StaticResource CloseButton}" ToolTip="{DynamicResource L.Close}"
                  Click="OnClose" WindowChrome.IsHitTestVisibleInChrome="True">
            <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.2" Width="10" Height="10"/>
          </Button>
        </StackPanel>
      </Grid>
      <!-- red racing line under the title -->
      <Rectangle Height="2" Fill="{StaticResource RedFade}" Margin="0,0,0,14"/>

      <StackPanel Margin="16,0,16,16">

        <!-- engine -->
        <Border x:Name="EngineCard" Style="{StaticResource CardBorder}" Background="{StaticResource HeroGradient}" Padding="0" ClipToBounds="True">
          <Grid>
            <!-- faint slanted stripes, the CM cut, behind the content -->
            <Canvas HorizontalAlignment="Right" Width="170" IsHitTestVisible="False" Opacity="0.07">
              <Canvas.RenderTransform><SkewTransform AngleX="-30"/></Canvas.RenderTransform>
              <Rectangle Canvas.Left="60" Width="26" Height="140" Fill="#FF0000"/>
              <Rectangle Canvas.Left="100" Width="26" Height="140" Fill="#FF0000"/>
              <Rectangle Canvas.Left="140" Width="26" Height="140" Fill="#FFFFFF"/>
            </Canvas>
            <Grid Margin="20,18,20,20">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="SCRIPT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Sub}"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                  <Ellipse x:Name="StatusDot" Width="11" Height="11" Fill="{StaticResource Dim}" Margin="0,1,10,0" VerticalAlignment="Center"/>
                  <TextBlock x:Name="StatusText" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Sub}"/>
                </StackPanel>
                <TextBlock x:Name="StatusDetail" Visibility="Collapsed" FontSize="12"
                           Foreground="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,4,0,0"/>
              </StackPanel>
              <Button x:Name="EngineButton" Grid.Column="1" Style="{StaticResource RaceButton}" Width="116" Height="46"
                      Click="OnEngineButton" Margin="12,0,0,0">
                <TextBlock x:Name="EngineButtonText" FontSize="14" FontWeight="Black" Foreground="White"/>
              </Button>
            </Grid>
          </Grid>
        </Border>

        <!-- steering -->
        <Border Style="{StaticResource CardBorder}">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
              <Rectangle Style="{StaticResource SlantTick}"/>
              <TextBlock Text="{DynamicResource L.Steering}" Style="{StaticResource SectionText}"/>
            </StackPanel>
            <Grid>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource L.Sensitivity}" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock Text="{DynamicResource L.SensitivityHint}" FontSize="12"
                           Foreground="{StaticResource Sub}" Margin="0,3,0,0"/>
              </StackPanel>
              <TextBlock x:Name="SensitivityValue" Text="20" FontSize="32" FontWeight="Black"
                         HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
            <Slider x:Name="SensitivitySlider" Style="{StaticResource SleekSlider}" Minimum="5" Maximum="50"
                    SmallChange="0.5" LargeChange="1" IsSnapToTickEnabled="True" TickFrequency="0.5"
                    Margin="0,12,0,0" ValueChanged="OnSensitivityChanged"
                    IsMoveToPointEnabled="True" PreviewMouseWheel="OnSensitivityWheel"/>
            <Grid Margin="0,2,0,0">
              <TextBlock Text="5" FontSize="11" Foreground="{StaticResource Dim}"/>
              <TextBlock Text="50" FontSize="11" Foreground="{StaticResource Dim}" HorizontalAlignment="Right"/>
            </Grid>

            <!-- live steering: transforms only, so it never re-runs layout -->
            <Rectangle Height="1" Fill="{StaticResource CardLine}" Margin="0,14,0,12"/>
            <Grid>
              <TextBlock Text="{DynamicResource L.Live}" FontSize="12" Foreground="{StaticResource Sub}"/>
              <TextBlock Text="{DynamicResource L.LiveHint}" FontSize="11" Foreground="{StaticResource Dim}" HorizontalAlignment="Right"
                         VerticalAlignment="Center"/>
            </Grid>
            <Grid Height="10" Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <Border Grid.ColumnSpan="2" CornerRadius="2" Background="{StaticResource Track}"/>
              <Border x:Name="SteerLeft" CornerRadius="2,0,0,2" Background="{StaticResource AccentGradient}" RenderTransformOrigin="1,0.5">
                <Border.RenderTransform><ScaleTransform ScaleX="0"/></Border.RenderTransform>
              </Border>
              <Border x:Name="SteerRight" Grid.Column="1" CornerRadius="0,2,2,0" Background="{StaticResource AccentGradient}" RenderTransformOrigin="0,0.5">
                <Border.RenderTransform><ScaleTransform ScaleX="0"/></Border.RenderTransform>
              </Border>
              <!-- quarter ticks and the center line -->
              <UniformGrid Grid.ColumnSpan="2" Columns="4" IsHitTestVisible="False">
                <Border BorderBrush="#0A0A0C" BorderThickness="0,0,1,0"/>
                <Border BorderBrush="#0A0A0C" BorderThickness="0,0,1,0"/>
                <Border BorderBrush="#0A0A0C" BorderThickness="0,0,1,0"/>
                <Border/>
              </UniformGrid>
              <Border Grid.ColumnSpan="2" Width="2" Margin="0,-3" Background="#F4F4F6" HorizontalAlignment="Center"/>
            </Grid>
            <Grid Margin="0,5,0,0">
              <TextBlock Text="{DynamicResource L.Left}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Dim}"/>
              <TextBlock Text="{DynamicResource L.Right}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Dim}" HorizontalAlignment="Right"/>
            </Grid>
          </StackPanel>
        </Border>

        <!-- cursor -->
        <Border Style="{StaticResource CardBorder}">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
              <Rectangle Style="{StaticResource SlantTick}"/>
              <TextBlock Text="{DynamicResource L.Cursor}" Style="{StaticResource SectionText}"/>
            </StackPanel>
            <Grid>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource L.HideCursor}" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock x:Name="HotkeyHint" FontSize="12"
                           Foreground="{StaticResource Sub}" Margin="0,3,0,0" TextWrapping="Wrap" MaxWidth="250" HorizontalAlignment="Left"/>
              </StackPanel>
              <!-- keycap look -->
              <Button x:Name="HotkeyButton" Style="{StaticResource FlatButton}" HorizontalAlignment="Right" VerticalAlignment="Center"
                      Padding="14,7" MinWidth="110" BorderThickness="1,1,1,3"
                      Click="OnHotkeyButton" PreviewKeyDown="OnHotkeyKeyDown" LostKeyboardFocus="OnHotkeyLostFocus">
                <TextBlock x:Name="HotkeyText" Text="Ctrl + 0" FontSize="13" FontWeight="Bold"/>
              </Button>
            </Grid>
          </StackPanel>
        </Border>

        <!-- system -->
        <Border Style="{StaticResource CardBorder}" Margin="0">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
              <Rectangle Style="{StaticResource SlantTick}"/>
              <TextBlock Text="{DynamicResource L.System}" Style="{StaticResource SectionText}"/>
            </StackPanel>
            <Grid>
              <StackPanel>
                <TextBlock Text="{DynamicResource L.StartWithWindows}" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock Text="{DynamicResource L.StartWithWindowsHint}" FontSize="12" Foreground="{StaticResource Sub}" Margin="0,3,0,0"/>
              </StackPanel>
              <CheckBox x:Name="StartupSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="OnStartupSwitch"/>
            </Grid>
          </StackPanel>
        </Border>

        <!-- credit -->
        <TextBlock x:Name="CreditText" Text="by weojiro" FontSize="11" Foreground="{StaticResource Dim}" Opacity="0.8"
                   HorizontalAlignment="Right" Margin="0,10,2,-6"/>

      </StackPanel>
    </StackPanel>
  </Border>
</Window>
